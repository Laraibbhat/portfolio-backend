# Local Development Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub - add it to .gitignore

# Database Configuration
# For local development with local MySQL: set these to your local MySQL values
# To test against Aiven MySQL: replace these with Aiven credentials (see DEPLOYMENT_GUIDE.md)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio_app
DB_USER=root
DB_PASSWORD=your_password_here
DB_USE_SSL=false
DB_REQUIRE_SSL=false
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=portfolio-avatars
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Java Options (optional)
JAVA_OPTS=-Xmx512m -Xms256m